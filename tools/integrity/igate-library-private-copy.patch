+// ===== MEASUREMENT ONLY: a full frame whose ending is the FEWEST bytes after which ANY following bytes still decode to the same text (no zero padding assumed, no trimming) =====
+namespace AprsCompress {
+    size_t encodeIndep(const uint8_t* text, size_t textLen, uint8_t* frame, size_t cap) {
+        if (textLen == 0 || textLen > MAX_TEXT || cap < 5) return 0;
+        Encoder e; e.init(frame + 4, cap - 4);
+        uint16_t freq[256];
+        for (size_t i = 0; i < textLen; i++) {
+            uint32_t total = buildFreq(text, i, freq, nullptr, 0);
+            uint32_t cum = 0; for (int sy = 0; sy < text[i]; sy++) cum += freq[sy];
+            e.encode(cum, freq[text[i]], total);
+        }
+        if (e.low >> 32) { e.carry(); e.low &= 0xFFFFFFFFull; }
+        uint64_t hi = e.low + e.range - 1;
+        for (int nb = 0; nb <= 4; nb++) {
+            uint64_t blk = nb == 4 ? 1ull : (1ull << (8 * (4 - nb)));          // every continuation of the nb emitted bytes lies in [v, v+blk)
+            uint64_t v = ((e.low + blk - 1) / blk) * blk;
+            if (v + blk - 1 <= hi) {
+                if (v >> 32) { e.carry(); v &= 0xFFFFFFFFull; }
+                for (int b = 0; b < nb; b++) e.putByte((uint8_t)(v >> (24 - 8 * b)));
+                break;
+            }
+        }
+        if (e.overflow) return 0;
+        frame[0] = HEADER_0; frame[1] = HEADER_1; frame[2] = VERSION_FLAG | AprsCompressModel::VERSION; frame[3] = (uint8_t)textLen;
+        return 4 + e.n;
+    }
+}
