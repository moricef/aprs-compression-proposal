+// ===== MEASUREMENT ONLY: a canonical-flush full frame, with an optional CRC-8 text check byte, for the truncation checks experiment =====
+namespace AprsCompress {
+    // 3C FF 81 <textLen> [<crc8 of text>] <range-coded bytes, exactly the bytes the decoder will consume>
+    size_t encodeCanon(const uint8_t* text, size_t textLen, uint8_t* frame, size_t cap, bool check) {
+        size_t hdr = check ? 5 : 4;
+        if (textLen == 0 || textLen > MAX_TEXT || cap < hdr + 1) return 0;
+        Encoder e; e.init(frame + hdr, cap - hdr);
+        uint16_t freq[256];
+        for (size_t i = 0; i < textLen; i++) {
+            uint32_t total = buildFreq(text, i, freq, nullptr, 0);
+            uint32_t cum = 0; for (int sy = 0; sy < text[i]; sy++) cum += freq[sy];
+            e.encode(cum, freq[text[i]], total);
+        }
+        for (int k = 0; k < 4; k++) e.shiftLow();                  // canonical flush: all four bytes of low, no trimming
+        if (e.overflow) return 0;
+        frame[0] = HEADER_0; frame[1] = HEADER_1; frame[2] = VERSION_FLAG | AprsCompressModel::VERSION; frame[3] = (uint8_t)textLen;
+        if (check) frame[4] = textCheck(text, textLen);
+        return hdr + e.n;
+    }
+    // payload = frame + hdr, `avail` bytes of it.  *needed = bytes the decoder asked for (beyond `avail` it read zeros).  Returns the text length or 0.
+    size_t decodeCanon(const uint8_t* frame, size_t frameLen, size_t hdrLen, size_t avail, uint8_t* text, size_t cap, bool check, size_t* needed) {
+        if (frameLen < hdrLen || frame[0] != HEADER_0 || frame[1] != HEADER_1 || frame[2] != (VERSION_FLAG | AprsCompressModel::VERSION)) return 0;
+        size_t textLen = frame[3]; if (textLen == 0 || textLen > cap) return 0;
+        Decoder d; d.init(frame + hdrLen, avail);
+        uint16_t freq[256];
+        for (size_t i = 0; i < textLen; i++) {
+            uint32_t total = buildFreq(text, i, freq, nullptr, 0);
+            uint32_t v = d.target(total);
+            uint32_t cum = 0; int sy = 0;
+            while (sy < 255 && cum + freq[sy] <= v) { cum += freq[sy]; sy++; }
+            d.consume(cum, freq[sy]);
+            text[i] = (uint8_t)sy;
+        }
+        *needed = d.pos;
+        if (check && frame[4] != textCheck(text, textLen)) return 0;
         return textLen;
     }
 }
